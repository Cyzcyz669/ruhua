<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 安装：sed -e "s#HOME_DIR#$HOME#g" -e "s#NODE_BIN#$(command -v node)#g" com.ruhua.loop.plist > ~/Library/LaunchAgents/com.ruhua.loop.plist
     启动：launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.ruhua.loop.plist
     停止：launchctl bootout gui/$(id -u)/com.ruhua.loop -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.ruhua.loop</string>
  <key>ProgramArguments</key><array>
    <string>/usr/bin/caffeinate</string><string>-i</string>
    <string>NODE_BIN</string><string>HOME_DIR/ruhua-mac/loop.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>HOME_DIR/ruhua-mac</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>HOME_DIR/ruhua-mac/loop.log</string>
  <key>StandardErrorPath</key><string>HOME_DIR/ruhua-mac/loop.log</string>
</dict></plist>
